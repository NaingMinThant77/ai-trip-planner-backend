# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Database (Supabase Postgres) ──────────────────────────────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string → "Session pooler".
#
# Use the SESSION pooler (port 5432). It is IPv4-reachable and supports DDL, so the same URL
# works for both the running app and `prisma migrate` — no second connection string needed.
#
# Do NOT use "Direct connection" (db.<ref>.supabase.co). It is IPv6-only, and most networks
# cannot route to it, giving Prisma error P1001 that looks like an outage but is not.
#
# Note the username is postgres.<project-ref>, not postgres.
#
# If your password contains @ # ? / : or ! — PERCENT-ENCODE it (@ → %40, # → %23, ! → %21).
# A Postgres URI splits credentials from host at the LAST '@' and treats '#' as a fragment,
# so an unencoded password silently produces a malformed URL. `npm run db:fix-url` does this
# for you, in place, without printing the secret.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Only needed if you switch DATABASE_URL to the TRANSACTION pooler (port 6543, add
# ?pgbouncer=true). That mode cannot run DDL, so migrations need a session connection —
# add `directUrl = env("DIRECT_URL")` to schema.prisma and set this to the port-5432 URL.
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Local SQLite alternative — works offline, no account needed.
# Set provider = "sqlite" in prisma/schema.prisma, delete prisma/migrations/, then:
#   DATABASE_URL="file:./dev.db"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"

# ── AI ────────────────────────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
# Without this the server still boots, but every AI route returns 503.
ANTHROPIC_API_KEY=""

# Optional. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL="claude-sonnet-5"

# Optional. Defaults to 3000.
PORT=3000

# ── Google sign-in (optional) ─────────────────────────────────────────────────
# Google Cloud console → APIs & Services → Credentials → OAuth client ID, type
# "Web application". Without these the server still boots and the Google button
# reports that it is unconfigured instead of failing.
#
# In that client, set:
#   Authorized JavaScript origins  →  leave EMPTY (this is a server-side code flow)
#   Authorized redirect URIs       →  <OAUTH_PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# The base URL the *browser* can reach this API on. It builds the redirect_uri, so it must
# match the console entry exactly. Google accepts only https:// or http://localhost here —
# a LAN IP such as http://192.168.1.5:3000 is rejected, so a physical device needs a tunnel.
OAUTH_PUBLIC_URL="http://localhost:3000"

# Comma-separated deep-link prefixes the callback may hand a token back to. Defaults to
# aitripplanner:// plus exp:// and http://localhost:8081/ outside production.
# PRODUCTION MUST SET THIS to the app scheme only.
# OAUTH_ALLOWED_REDIRECTS="aitripplanner://"
