// Postgres (Supabase). Enums and arrays are still String columns — that is a leftover from the
// original SQLite design (decision #2), not a Postgres constraint. See memory/04-data-model.md
// for what could now be tightened, and #13 for why the move happened.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime connection. Use Supabase's TRANSACTION pooler (port 6543) + ?pgbouncer=true.
  url       = env("DATABASE_URL")
  // Migrations need a real session: PgBouncer transaction mode has no DDL or advisory locks.
  // directUrl = env("DIRECT_URL")
}

model User {
  id    String @id @default(cuid())
  email String @unique
  /// Null for accounts created through Google — there is no password to compare against.
  /// `AuthService.login` rejects these with a "sign in with Google" message.
  passwordHash String?
  /// Google's stable `sub` claim. Set when an account is created through or linked to Google.
  googleId     String? @unique
  name         String
  /// Home city, used to personalise suggestions. Optional — asked for during onboarding.
  homeCity     String?
  /// JSON-encoded string[] of travel interests. Seeds personalised suggestions.
  interests    String   @default("[]")
  /// Short code other people type to add this user as family. Null until the profile is
  /// first read — minted lazily by `UsersService.ensureInviteCode`.
  inviteCode   String?  @unique
  /// Cloudinary secure URL of the profile photo. Null means the UI falls back to initials.
  avatarUrl    String?
  /// Cloudinary public_id. Kept so replacing a photo can delete the one it replaced —
  /// without it the old image stays in the account forever.
  avatarPublicId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips         Trip[]
  photos        TripPhoto[]
  conversations AgentConversation[]
  /// People this user added to their own family list.
  family        FamilyMember[]      @relation("FamilyOwner")
  /// Lists this user appears in, because someone else entered their invite code.
  familyOf      FamilyMember[]      @relation("FamilyMemberUser")
  messagesSent     Message[] @relation("MessageSender")
  messagesReceived Message[] @relation("MessageRecipient")
}

/// Someone kept on hand so any trip can be shared in one tap. Mutual: one row represents the
/// relationship regardless of who typed the code, so it appears in both people's lists and a
/// delete from either side removes it for both (supersedes decision #19's one-directional model).
model FamilyMember {
  id       String   @id @default(cuid())
  /// The user who typed the invite code when the relationship was created.
  ownerId  String
  /// The user whose invite code was typed.
  memberId String
  addedAt  DateTime @default(now())

  owner  User @relation("FamilyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  member User @relation("FamilyMemberUser", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([ownerId, memberId])
  @@index([ownerId])
  @@index([memberId])
}

/// A direct message between two users. Restricted to people who are mutual family members
/// (see FamilyMember) — there is no general "message any user" surface.
model Message {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  text        String
  createdAt   DateTime  @default(now())
  /// Null until the recipient opens the thread. Set in bulk for every unread message in a
  /// thread at once, not per-message — good enough for read ticks, not a per-message receipt.
  readAt      DateTime?

  sender    User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}

model Trip {
  id          String   @id @default(cuid())
  userId      String
  title       String
  /// Departure city/place the traveller is leaving from.
  source      String   @default("")
  destination String
  /// Nullable: set once the destination is resolved to a place, used to centre the map.
  latitude    Float?
  longitude   Float?
  startDate   DateTime
  endDate     DateTime
  travelers   Int      @default(1)
  notes       String?
  /// draft | generating | ready | failed
  status      String   @default("draft")
  coverImageUrl String?
  /// Cloudinary public_id for coverImageUrl. Kept so replacing or deleting the trip can
  /// delete the asset — without it the image stays in the account forever.
  coverImagePublicId String?
  /// Set when the traveller creates a share link; null means the trip is private.
  shareToken  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  days          TripDay[]
  packingItems  PackingItem[]
  photos        TripPhoto[]
  bookings      Booking[]
  collaborators TripCollaborator[]
  conversations AgentConversation[]

  @@index([userId])
}

model TripDay {
  id        String   @id @default(cuid())
  tripId    String
  dayNumber Int
  date      DateTime
  title     String
  summary   String

  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@unique([tripId, dayNumber])
  @@index([tripId])
}

model Activity {
  id          String @id @default(cuid())
  dayId       String
  position    Int
  /// morning | afternoon | evening
  timeOfDay   String
  title       String
  description String
  location    String
  /// Model-supplied approximate coordinates. Null is normal and the map must handle it.
  latitude    Float?
  longitude   Float?
  durationMin Int
  /// "HH:mm", 24-hour. Null on generated stops, which only carry a time of day.
  startTime   String?
  endTime     String?
  /// Model-produced text such as "around $25pp". Never render this as a factual price.
  costEstimate String?

  day TripDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
}

model PackingItem {
  id        String   @id @default(cuid())
  tripId    String
  label     String
  /// clothing | documents | electronics | toiletries | health | other
  category  String   @default("other")
  quantity  Int      @default(1)
  isPacked  Boolean  @default(false)
  /// ai | user — lets the UI show what was suggested vs. what the traveller added.
  source    String   @default("user")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model TripPhoto {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  /// Path relative to the uploads root. Served via GET /api/uploads/:fileName.
  fileName  String
  caption   String?
  width     Int?
  height    Int?
  sizeBytes Int
  mimeType  String
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

/// Saved booking *information* only — no inventory, payment, or reservation. See 01-product.md.
model Booking {
  id          String    @id @default(cuid())
  tripId      String
  /// hotel | car | flight
  kind        String
  title       String
  provider    String
  /// Indicative price as text, e.g. "from $180/night". Never treated as a quote.
  priceText   String?
  startsAt    DateTime?
  endsAt      DateTime?
  location    String?
  /// Free-form JSON string with kind-specific fields (flight number, room type, ...).
  detailsJson String    @default("{}")
  externalUrl String?
  /// saved | dismissed
  status      String    @default("saved")
  createdAt   DateTime  @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

/// A family member the itinerary was shared with. Read-only for now (01-product.md).
model TripCollaborator {
  id        String   @id @default(cuid())
  tripId    String
  email     String
  name      String?
  /// viewer — the only role in v1
  role      String   @default("viewer")
  invitedAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, email])
  @@index([tripId])
}

model AgentConversation {
  id        String   @id @default(cuid())
  userId    String
  /// Null for a general conversation not tied to one trip.
  tripId    String?
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip     Trip?          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  messages AgentMessage[]

  @@index([userId])
}

model AgentMessage {
  id             String   @id @default(cuid())
  conversationId String
  /// user | assistant
  role           String
  /// Plain-text rendering. For assistant turns this is a fallback if blocks fail to render.
  text           String
  /// JSON-encoded UiBlock[]. Empty array for user turns. See agent/blocks.schema.ts.
  blocksJson     String   @default("[]")
  createdAt      DateTime @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

/// Seeded catalogue backing the Explore tab. Not user-generated.
model Destination {
  id           String @id @default(cuid())
  slug         String @unique
  name         String
  country      String
  region       String
  summary      String
  /// JSON-encoded string[] of tags, matched against user interests for ranking.
  tags         String @default("[]")
  /// JSON-encoded number[] of month indices (1-12) when this place is at its best.
  bestMonths   String @default("[]")
  heroImageUrl String?
  latitude     Float
  longitude    Float
  /// Rough daily spend per person, indicative only.
  dailyBudgetText String?
  /// Seeded editorial score (0-100) that ranks Trending; real trips planned add to it.
  popularity   Int    @default(0)
  /// JSON-encoded DestinationGuide (intro, places, restaurants, culture, food, stay, packing) with
  /// resolved photo URLs. Seeded from prisma/guides.ts; parsed defensively by ExploreService.
  guide        String @default("{}")

  @@index([region])
}
