# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Database (Supabase Postgres) ──────────────────────────────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string → "Session pooler".
#
# Use the SESSION pooler (port 5432). It is IPv4-reachable and supports DDL, so the same URL
# works for both the running app and `prisma migrate` — no second connection string needed.
#
# Do NOT use "Direct connection" (db.<ref>.supabase.co). It is IPv6-only, and most networks
# cannot route to it, giving Prisma error P1001 that looks like an outage but is not.
#
# Note the username is postgres.<project-ref>, not postgres.
#
# If your password contains @ # ? / : or ! — PERCENT-ENCODE it (@ → %40, # → %23, ! → %21).
# A Postgres URI splits credentials from host at the LAST '@' and treats '#' as a fragment,
# so an unencoded password silently produces a malformed URL. `npm run db:fix-url` does this
# for you, in place, without printing the secret.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Only needed if you switch DATABASE_URL to the TRANSACTION pooler (port 6543, add
# ?pgbouncer=true). That mode cannot run DDL, so migrations need a session connection —
# add `directUrl = env("DIRECT_URL")` to schema.prisma and set this to the port-5432 URL.
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Local SQLite alternative — works offline, no account needed.
# Set provider = "sqlite" in prisma/schema.prisma, delete prisma/migrations/, then:
#   DATABASE_URL="file:./dev.db"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"

# Optional. Defaults to 3000.
PORT=3000

# ── Google sign-in (optional) ─────────────────────────────────────────────────
# Google Cloud console → APIs & Services → Credentials → OAuth client ID, type
# "Web application". Without these the server still boots and the Google button
# reports that it is unconfigured instead of failing.
#
# In that client, set:
#   Authorized JavaScript origins  →  leave EMPTY (this is a server-side code flow)
#   Authorized redirect URIs       →  <OAUTH_PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# The base URL the *browser on the device* can reach this API on. It builds the redirect_uri,
# so it must match the console entry byte for byte.
#
# Google accepts ONLY https://, http://localhost or http://127.0.0.1 here — a LAN IP such as
# http://192.168.1.5:3000 is rejected outright. That is why this is localhost, and why a
# phone lands on "localhost refused to connect" straight after consent unless you do one of:
#
#   A. Android on USB or an emulator — leave this as-is and bridge the port:
#          cd frontend && npm run oauth:bridge      # adb reverse tcp:3000 tcp:3000
#      The device's own localhost:3000 then reaches this server. Nothing else changes,
#      and the console entry below stays valid. Re-run it after a reconnect.
#
#   B. Any device, including iPhone — put an https tunnel in front of the backend:
#          cloudflared tunnel --url http://localhost:3000
#      then set OAUTH_PUBLIC_URL to the tunnel URL, add <tunnel>/api/auth/google/callback
#      to the console, and set EXPO_PUBLIC_API_URL=<tunnel>/api in frontend/.env.
#
# The server prints the resolved redirect_uri at boot, so check that line first if Google
# reports redirect_uri_mismatch.
OAUTH_PUBLIC_URL="http://localhost:3000"

# Comma-separated deep-link prefixes the callback may hand a token back to. Defaults to
# aitripplanner:// plus exp:// and http://localhost:8081/ outside production.
# PRODUCTION MUST SET THIS to the app scheme only.
# OAUTH_ALLOWED_REDIRECTS="aitripplanner://"

# ── Cloudinary (profile photos) ───────────────────────────────────────────────
# Cloudinary dashboard → Product Environment Credentials. Without these the server still
# boots and avatar uploads return 503 with a message saying so — nothing else is affected.
# Signed server-side uploads: the API secret never reaches the app. Decision #20.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Chat agent (Gemini, streaming) ────────────────────────────────────────────
# https://aistudio.google.com/apikey
# Without this the server still boots, and the chat page shows a configuration error in-thread.
GEMINI_API_KEY=""

# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL="gemini-3.8-flash"

# Optional. Comma-separated models tried in order when GEMINI_MODEL's quota is spent (HTTP 429).
# Defaults to gemini-3.5-flash-lite — higher free limits, but weaker at building trip cards.
# GEMINI_FALLBACK_MODELS="gemini-3.5-flash-lite"
